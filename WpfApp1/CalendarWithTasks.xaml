<Window x:Class="TimeToTask.CalendarWithTasks"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Календарь" 
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12">
                <Button Content="◀" Width="30" Click="PreviousMonth_Click" Style="{StaticResource NavButton}"/>
                <TextBlock x:Name="MonthYearText" Width="170" TextAlignment="Center"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextColor}"/>
                <Button Content="▶" Width="30" Click="NextMonth_Click" Style="{StaticResource NavButton}"/>

                <Button Content="⌂ Главное меню" Click="BackToMainMenu_Click" Style="{StaticResource PastelButton}" Margin="10,0"/>
            </StackPanel>

            <!-- Дни недели (под панелью) -->
            <UniformGrid Grid.Row="1" Columns="7" Margin="5,5,5,0">
                <TextBlock Text="Пн" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextColor}"/>
                <TextBlock Text="Вт" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextColor}"/>
                <TextBlock Text="Ср" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextColor}"/>
                <TextBlock Text="Чт" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextColor}"/>
                <TextBlock Text="Пт" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextColor}"/>
                <TextBlock Text="Сб" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource WeekendTextColor}"/>
                <TextBlock Text="Вс" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource WeekendTextColor}"/>
            </UniformGrid>

            <UniformGrid x:Name="DaysGrid" Grid.Row="2" Columns="7" Margin="8"/>
        </Grid>

        <!-- Управление задачами -->
        <Popup x:Name="TaskPopup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False"
               Width="300" MaxHeight="450" PopupAnimation="Fade">
            <Border Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#1A1B26" ShadowDepth="6" BlurRadius="16" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel Margin="14">
                    <TextBlock x:Name="PopupDateText" FontWeight="Bold" FontSize="15"
                               Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,6"/>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TasksPanel"/>
                    </ScrollViewer>
                    <Button x:Name="ShowAddPanelButton" Content="✚ Добавить задачу"
                            Click="ShowAddPanel_Click" Margin="0,8,0,0" Style="{StaticResource PastelButton}"/>
                    <Border x:Name="AddTaskPanel" Visibility="Collapsed" Margin="0,8,0,0"
                            Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="10">
                        <StackPanel>
                            <TextBox x:Name="TaskTextBox" Text="Название задачи"
                                     GotFocus="TaskTextBox_GotFocus" Margin="0,0,0,8"
                                     Style="{StaticResource PastelTextBox}"/>
                            <CheckBox x:Name="PermanentCheckBox" Content="Постоянная задача"
                                      Checked="PermanentCheckBox_Changed" Unchecked="PermanentCheckBox_Changed"
                                      Foreground="{DynamicResource PrimaryTextColor}"/>
                            <ComboBox x:Name="DayOfWeekComboBox" Visibility="Collapsed" Margin="0,5" Style="{StaticResource PastelComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Foreground="{DynamicResource PrimaryTextColor}"
                      Checked="DayCheckBox_Changed" Unchecked="DayCheckBox_Changed"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox x:Name="MonthComboBox" Visibility="Collapsed" Margin="0,5"
                                      SelectionChanged="MonthComboBox_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="Сохранить" Click="AddTask_Click"
                                        Style="{StaticResource SmallPastelButton}" Width="80"/>
                                <Button Content="Отмена" Click="CancelAddTask_Click"
                                        Style="{StaticResource SmallPastelButton}" Width="60" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>