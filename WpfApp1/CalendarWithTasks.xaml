<Window x:Class="TimeToTask.CalendarWithTasks"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Трекер привычек" Height="580" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">
    <Window.Resources>
        <Style x:Key="NavToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonHover}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PastelButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallPastelButton" TargetType="Button" BasedOn="{StaticResource PastelButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style x:Key="PastelTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PastelComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="3" VerticalAlignment="Center"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="{StaticResource InputBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource IconButtonHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DayButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DayButtonBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DayButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DayButtonHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    
    
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12">
                <Button Content="◀" Width="30" Click="PreviousMonth_Click" Style="{StaticResource NavButton}"/>
                <TextBlock x:Name="MonthYearText" Width="170" TextAlignment="Center"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextColor}"/>
                <Button Content="▶" Width="30" Click="NextMonth_Click" Style="{StaticResource NavButton}"/>
                <ToggleButton x:Name="ThemeToggleBtn" Content="🌙" Width="40" Margin="15,0,5,0"
                              Style="{StaticResource NavToggleButton}" Checked="ThemeToggleBtn_Checked"
                              Unchecked="ThemeToggleBtn_Unchecked"/>
                <Button Content="⌂ Главное меню" Click="BackToMainMenu_Click" Style="{StaticResource PastelButton}" Margin="10,0"/>
            </StackPanel>

            <UniformGrid Grid.Row="1" Columns="7" Margin="5,5,5,0">
                <TextBlock Text="Пн" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource SecondaryTextColor}"/>
                <TextBlock Text="Вт" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource SecondaryTextColor}"/>
                <TextBlock Text="Ср" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource SecondaryTextColor}"/>
                <TextBlock Text="Чт" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource SecondaryTextColor}"/>
                <TextBlock Text="Пт" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource SecondaryTextColor}"/>
                <TextBlock Text="Сб" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource WeekendTextColor}"/>
                <TextBlock Text="Вс" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource WeekendTextColor}"/>
            </UniformGrid>

            <UniformGrid x:Name="DaysGrid" Grid.Row="2" Columns="7" Margin="8"/>
        </Grid>

        <Popup x:Name="TaskPopup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False"
               Width="300" MaxHeight="450" PopupAnimation="Fade">
            <Border Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#1A1B26" ShadowDepth="6" BlurRadius="16" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel Margin="14">
                    <TextBlock x:Name="PopupDateText" FontWeight="Bold" FontSize="15"
                               Foreground="{StaticResource PrimaryTextColor}" Margin="0,0,0,6"/>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TasksPanel"/>
                    </ScrollViewer>
                    <Button x:Name="ShowAddPanelButton" Content="✚ Добавить задачу"
                            Click="ShowAddPanel_Click" Margin="0,8,0,0" Style="{StaticResource PastelButton}"/>
                    <Border x:Name="AddTaskPanel" Visibility="Collapsed" Margin="0,8,0,0"
                            Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="10">
                        <StackPanel>
                            <TextBox x:Name="TaskTextBox" Text="Название задачи"
                                     GotFocus="TaskTextBox_GotFocus" Margin="0,0,0,8"
                                     Style="{StaticResource PastelTextBox}"/>
                            <CheckBox x:Name="PermanentCheckBox" Content="Постоянная задача"
                                      Checked="PermanentCheckBox_Changed" Unchecked="PermanentCheckBox_Changed"
                                      Foreground="{StaticResource PrimaryTextColor}"/>
                            <ComboBox x:Name="DayOfWeekComboBox" Visibility="Collapsed" Margin="0,5"
                                      Style="{StaticResource PastelComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Checked="DayCheckBox_Changed"
                                                  Unchecked="DayCheckBox_Changed"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox x:Name="MonthComboBox" Visibility="Collapsed" Margin="0,5"
                                      Style="{StaticResource PastelComboBox}"
                                      SelectionChanged="MonthComboBox_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="Сохранить" Click="AddTask_Click"
                                        Style="{StaticResource SmallPastelButton}" Width="80"/>
                                <Button Content="Отмена" Click="CancelAddTask_Click"
                                        Style="{StaticResource SmallPastelButton}" Width="60" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>