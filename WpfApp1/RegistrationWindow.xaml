<Window x:Class="TimeToTask.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TimeToTask"
        mc:Ignorable="d"
        Title="Регистрация" Height="720" Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="500,100,500,100">
            <TextBlock Text="Регистрация" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Top"/>

            <TextBlock Text="Логин" FontSize="24" TextAlignment="Center" Margin="20"/>
            <TextBox x:Name="txtgLogin" Margin="5" Height="25" Width="200" FontSize="18"/>

            <TextBlock Text="Пароль" FontSize="24" TextAlignment="Center" Margin="20"/>
            <Grid Width="200" Height="25" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="txtPassword" 
                             Grid.Column="0" 
                             Grid.ColumnSpan="2"
                             FontSize="18"
                             Padding="2,0,30,0"
                             VerticalContentAlignment="Center"/>
                <TextBox x:Name="txtPasswordTextBox" 
                         Grid.Column="0" 
                         Grid.ColumnSpan="2"
                         FontSize="18" 
                         Visibility="Collapsed"
                         Padding="2,0,30,0"
                         VerticalContentAlignment="Center"/>
                <Button x:Name="btnTogglePassword" 
                        Grid.Column="1"
                        Width="25" 
                        Height="23" 
                        Content="👁" 
                        Background="Transparent" 
                        BorderThickness="0"
                        Margin="0,0,3,0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        PreviewMouseDown="btnTogglePassword_PreviewMouseDown"
                        PreviewMouseUp="btnTogglePassword_PreviewMouseUp"
                        MouseLeave="btnTogglePassword_MouseLeave"/>
            </Grid>

            <TextBlock Text="Почта" FontSize="24" TextAlignment="Center" Margin="20"/>
            <TextBox x:Name="txtMail" Margin="5" Height="25" Width="200" FontSize="18"/>

            <Button x:Name="btnRegistration" Content="Регистрация" FontSize="24" Margin="40" Height="40" Width="150" Click="btnRegistration_Click"/>
        </StackPanel>
    </Grid>
</Window>