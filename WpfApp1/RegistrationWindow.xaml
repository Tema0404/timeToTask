<Window x:Class="TimeToTask.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TimeToTask"
        mc:Ignorable="d"
        Title="Регистрация" Height="720" Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">
    <Grid Width="300" VerticalAlignment="Center">
        <StackPanel Orientation="Vertical" >
            <TextBlock Text="Регистрация" FontSize="50"  FontWeight="Bold" Foreground="{StaticResource PrimaryTextColor}" HorizontalAlignment="Center" VerticalAlignment="Top"/>

            <!-- Логин -->
            <TextBlock Text="Логин" FontSize="24"  FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextColor}" TextAlignment="Center" Margin="20"/>
            <Grid Width="180">
                <TextBox x:Name="txtLogin" Style="{StaticResource AccountTextBox}"/>
            </Grid>

            <!-- Пароль -->
            <TextBlock Text="Пароль" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextColor}" TextAlignment="Center" Margin="20"/>
            <Grid Width="180">
                <TextBox x:Name="txtPasswordTextBox" Style="{DynamicResource AccountTextBox}"/>
                <PasswordBox x:Name="txtPassword" Style="{DynamicResource AccountPasswordBox}" 
                             Visibility="Visible"/>
                <ToggleButton x:Name="btnTogglePassword" Style="{DynamicResource EyeToggleButton}" 
                              HorizontalAlignment="Right" Margin="0,0,5,0" Checked="ToggleFirst_Checked" Unchecked="ToggleFirst_Unchecked"/>
            </Grid>

            <!-- Пароль повторно -->
            <TextBlock Text="Повторите пароль" FontSize="24" FontWeight="SemiBold" 
                       Foreground="{DynamicResource SecondaryTextColor}" TextAlignment="Center" Margin="20"/>
            <Grid Width="180">
                <TextBox x:Name="txtPasswordTextBoxReplay" Style="{DynamicResource AccountTextBox}"/>
                <PasswordBox x:Name="txtPasswordReplay" Style="{DynamicResource AccountPasswordBox}" 
                             Visibility="Visible"/>
                <ToggleButton x:Name="btnTogglePasswordReplay" Style="{DynamicResource EyeToggleButton}" HorizontalAlignment="Right" Margin="0,0,5,0" Checked="ToggleReplay_Checked" Unchecked="ToggleReplay_Unchecked"/>
            </Grid>

            <!-- Почта -->
            <TextBlock Text="Почта" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextColor}" TextAlignment="Center" Margin="20"/>
            <Grid Width="180">
                <TextBox x:Name="txtMail" Style="{StaticResource AccountTextBox}"/>
            </Grid>

            <!-- Регистрация -->
            <Button x:Name="btnRegistration" Content="Регистрация" Style="{StaticResource ActionPastelButton}" Background="{StaticResource AccentColor}" Foreground="White" Margin="40" Width="150" Click="btnRegistration_Click"/>

            <!-- Переход ко входу -->
            <TextBlock TextAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextColor}">
                Есть аккаунт?
                <LineBreak/>
                    <Hyperlink Click="EntryHyperLink_Click">
                        Войти
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>