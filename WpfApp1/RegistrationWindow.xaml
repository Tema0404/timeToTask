<Window x:Class="TimeToTask.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TimeToTask"
        mc:Ignorable="d"
        Title="Регистрация" Height="720" Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="500,100,500,100">
            <TextBlock Text="Регистрация" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <TextBlock Text="Логин" FontSize="24" TextAlignment="Center" Margin="20"/>
            <TextBox x:Name="getRegLogin" Margin="5" Height="25" Width="150" FontSize="18"/>
            <TextBlock Text="Пароль" FontSize="24" TextAlignment="Center" Margin="20"/>
            <PasswordBox x:Name="getRegPassword" Margin="5" Height="25" Width="150" FontSize="18" PasswordChar="*"/>
            <TextBlock Text="Почта" FontSize="24" TextAlignment="Center" Margin="20"/>
            <TextBox x:Name="getMail" Margin="5" Height="25" Width="150" FontSize="18"/>
            <Button x:Name="btnRegistration" Content="Регистрация" FontSize="24" Margin="40" Height="40" Width="150" Click="btnRegistration_Click"/>
        </StackPanel>
    </Grid>
</Window>
