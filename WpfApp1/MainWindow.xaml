                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"/>
 >>>> Ivan -->
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="AccountSidePanel" Visibility="Collapsed" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderColor}">
                <StackPanel Margin="20">
                    <TextBlock Text="Личный кабинет" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryTextColor}" HorizontalAlignment="Center" Margin="0,20,0,30"/>

                    <Button x:Name="btnChangePassword" Content="🔐 Сменить пароль" 
                            Height="40" Margin="0,0,0,15" Style="{StaticResource PastelButton}" FontSize="15" Click="btnChangePassword_Click"/>

                    <Button x:Name="btnExitAcc" Content="🚪 Выйти из аккаунта" 
                            Height="40" Style="{StaticResource PastelButton}" FontSize="15" Background="#FFE5E5" BorderBrush="#FFCCCC" Click="btnExitAcc_Click"/>

                    <Button x:Name="btnDeleteAccount" 
                            Grid.Row="1" 
                            Content="❌ Удалить аккаунт" 
                            Style="{StaticResource DangerPastelButton}" 
                            Margin="20,10,20,20" 
                            VerticalAlignment="Bottom"
                            Click="btnDeleteAccount_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#01000000" MouseDown="ClosePanel_MouseDown"/>
        </Grid>
    </Grid>
</Window>