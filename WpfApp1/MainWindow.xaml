<Window x:Class="TimeToTask.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Трекер привычек – Сегодня" Height="720" Width="1280"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <Style x:Key="DangerPastelButton" TargetType="Button">
            <Setter Property="Background" Value="#FFF0F0"/>
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="15,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFD6D6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Grid Grid.Row="0" Margin="30,15,30,15">
            <Button x:Name="btnAccSettings" Content="⚙️ Настройки" 
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Click="btnAccSettings_Click" Style="{StaticResource PastelButton}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="DateText" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" VerticalAlignment="Center"/>
                <Button x:Name="btnToCalendar" Content="📆 Календарь" Margin="30,0,0,0" Click="btnToCalendar_Click" Style="{DynamicResource PastelButton}"/>
                
            </StackPanel>
        </Grid>


        <ScrollViewer Grid.Row="1" Margin="30,10,30,30">
            <StackPanel>
                <!-- Добавление задачи -->
                <Button Content="✚ Добавить задачу" Click="ShowAddPanel_Click" HorizontalAlignment="Left" Margin="0,0,0,10" Style="{StaticResource PastelButton}"/>
                <Border x:Name="AddTaskPanel" Visibility="Collapsed" Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBox x:Name="TaskTextBox" Text="Название задачи" GotFocus="TaskTextBox_GotFocus" Style="{StaticResource PastelTextBox}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="PermanentCheckBox" Content="Постоянная задача" Checked="PermanentCheckBox_Changed" Unchecked="PermanentCheckBox_Changed" Foreground="{DynamicResource PrimaryTextColor}"/>
                        <ComboBox x:Name="DayOfWeekComboBox" Visibility="Collapsed" Margin="0,5" Style="{StaticResource PastelComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Foreground="{DynamicResource PrimaryTextColor}"
                      Checked="DayCheckBox_Changed" Unchecked="DayCheckBox_Changed"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="MonthComboBox" Visibility="Collapsed" Margin="0,5"
                                  SelectionChanged="MonthComboBox_SelectionChanged"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="Сохранить" Click="AddTask_Click" Style="{StaticResource SmallPastelButton}" Width="80"/>
                            <Button Content="Отмена" Click="CancelAddTask_Click" Style="{StaticResource SmallPastelButton}" Width="60" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Редактирование задачи -->
                <ItemsControl x:Name="TasksItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource InputBackground}" CornerRadius="8" Margin="0,4" Padding="10,8"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" Tag="{Binding}"
                                                  Checked="TaskCheckBox_Changed" Unchecked="TaskCheckBox_Changed"
                                                  VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextColor}"/>
                                        <TextBlock Text="{Binding Description}" Margin="8,0,0,0" Foreground="{DynamicResource PrimaryTextColor}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="✕" Style="{StaticResource IconButton}" Tag="{Binding}" ToolTip="Убрать из этого дня" Click="RemoveTaskFromDay_Click"/>
                                        <Button Content="📄" Style="{StaticResource IconButton}" Tag="{Binding}" ToolTip="Заметка" Click="ShowNote_Click"/>
                                        <Button Content="✎" Style="{StaticResource IconButton}" Tag="{Binding}" ToolTip="Редактировать название" Click="EditTask_Click"/>
                                        <Button Content="🗑" Style="{StaticResource IconButton}" Tag="{Binding}" ToolTip="Удалить" Click="DeleteTask_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Боковая панель -->
        <Grid x:Name="AccountSidePanel" Visibility="Collapsed" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BorderColor}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="1*" MinHeight="0"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Личный кабинет" Grid.Row="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" HorizontalAlignment="Center"/>

                    <Button x:Name="btnExitAcc" Content="🚪 Выйти из аккаунта" Grid.Row="1"
                            Height="40" Style="{DynamicResource PastelButton}" FontSize="15" Click="btnExitAcc_Click"/>

                    <Button x:Name="btnChangePassword" Content="🔐 Сменить пароль" Grid.Row="2"
                            Height="40" Margin="0,0,0,15" Style="{DynamicResource PastelButton}" FontSize="15" Click="btnChangePassword_Click"/>

                    <ToggleButton x:Name="ThemeToggleBtn" Content="🌙" Grid.Row="4" Width="50" Height="35"
                            Style="{DynamicResource NavToggleButton}" Checked="ThemeToggleBtn_Checked"
                            Unchecked="ThemeToggleBtn_Unchecked"/>

                    <Button x:Name="btnDeleteAccount" 
                            Grid.Row="5" 
                            Content="❌ Удалить аккаунт" 
                            Style="{DynamicResource DangerPastelButton}" 
                            
                            VerticalAlignment="Bottom"
                            Click="btnDeleteAccount_Click"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#01000000" MouseDown="ClosePanel_MouseDown"/>
        </Grid>
    </Grid>
</Window>