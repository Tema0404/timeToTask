<Window x:Class="TimeToTask.EntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TimeToTask"
        mc:Ignorable="d"
        Title="Вход в аккаунт" Height="720" Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="2" Grid.Row="1" Grid.RowSpan="3" Orientation="Vertical">
            <TextBlock Text="Вход"  FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Top"/>

            <TextBlock Text="Логин" FontSize="24" TextAlignment="Center" Margin="20"/>
            <TextBox x:Name="txtLogin" Margin="5" Height="25" Width="150" FontSize="18"/>

            <TextBlock Text="Пароль" FontSize="24" TextAlignment="Center" Margin="20"/>

            <Grid Width="185" HorizontalAlignment="Center" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <PasswordBox x:Name="txtPassword" Height="25" FontSize="18"/>
                    <TextBox x:Name="txtPasswordReveal" Height="25" FontSize="18" Visibility="Collapsed"/>
                </Grid>

                <Button x:Name="btnTogglePassword" Grid.Column="1" Margin="5,0,0,0" Height="25" 
                        Content="👁" FontSize="14" Padding="0" 
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                        Click="btnTogglePassword_Click"/>
            </Grid>

            <Button x:Name="btnEnterAcc" Content="Войти" FontSize="24" Margin="20" Width="150" Height="35" Click="btnEnterAcc_Click"/>

            <TextBlock TextAlignment="Center" FontSize="20" Margin="20">
                Нет аккаунта?
                <LineBreak/>
                <Hyperlink Click="RegistrtionHyperLink_Click">
                    Зарегистрироваться
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>