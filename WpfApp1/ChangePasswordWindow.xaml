<Window x:Class="WpfApp1.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля"
        Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}">
    <Window.Resources>
        <Style x:Key="AccountTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EyeToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="5">
                            <TextBlock x:Name="EyeIcon" Text="👁️" FontSize="14" 
                                   Foreground="{StaticResource SecondaryTextColor}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EyeIcon" Property="Foreground" Value="{StaticResource PrimaryTextColor}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="EyeIcon" Property="Text" Value="🙈"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionPastelButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="15,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="30,20,30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Безопасность" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryTextColor}" HorizontalAlignment="Center"/>
            <TextBlock Text="Установите новый надежный пароль для вашего аккаунта" FontSize="12" Foreground="{StaticResource SecondaryTextColor}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Поля ввода -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Старый пароль -->
            <TextBlock Text="Текущий пароль" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextColor}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,16">
                <TextBox x:Name="txtOldPassword" Style="{StaticResource AccountTextBox}"/>
                <PasswordBox x:Name="pwdOldPassword" Style="{StaticResource AccountPasswordBox}" Visibility="Visible" PasswordChanged="PasswordBox_PasswordChanged"/>
                <ToggleButton x:Name="btnToggleOld" Style="{StaticResource EyeToggleButton}" HorizontalAlignment="Right" Margin="0,0,5,0" Checked="ToggleOld_Checked" Unchecked="ToggleOld_Unchecked"/>
            </Grid>

            <TextBlock Text="Новый пароль" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextColor}" Margin="0,0,0,6"/>
            <Grid>
                <TextBox x:Name="txtNewPassword" Style="{StaticResource AccountTextBox}"/>
                <PasswordBox x:Name="pwdNewPassword" Style="{StaticResource AccountPasswordBox}" Visibility="Visible" PasswordChanged="PasswordBox_PasswordChanged"/>
                <ToggleButton x:Name="btnToggleNew" Style="{StaticResource EyeToggleButton}" HorizontalAlignment="Right" Margin="0,0,5,0" Checked="ToggleNew_Checked" Unchecked="ToggleNew_Unchecked"/>
            </Grid>
        </StackPanel>

        <!-- Кнопки действий -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnCancel" Content="Отмена" Grid.Column="0" Margin="0,0,10,0" Style="{StaticResource ActionPastelButton}" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Content="Сохранить" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource ActionPastelButton}" Background="{StaticResource AccentColor}" Foreground="White" Click="btnSave_Click"/>
        </Grid>
    </Grid>
</Window>